# Configuration de l'environnement (Copier en .env)
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Google Sheets Config
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
SPREADSHEET_MEALS_SHOPPING_ID=
SPREADSHEET_BUDGET_ID=
SPREADSHEET_SPORT_ID=

# Google Agenda & Tasks (OAuth utilisateur, client « Application de bureau »)
# Le jeton de rafraîchissement est écrit ici par : .venv/bin/python scripts/google_oauth_login.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# LLM Config (Google Gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=auto
# GEMINI_MAX_DAILY_REQUESTS=1000
# Compréhension des demandes : legacy (regex puis Gemini en dernier recours) | agent (Gemini en premier, outils typés)
# NLU_MODE=legacy
